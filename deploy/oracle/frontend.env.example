# Oracle VM host deployment (frontend)
NODE_ENV=production
NEXTAUTH_URL=https://YOUR_DOMAIN
NEXTAUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Server-side NextAuth -> backend connection (not public browser URL).
BACKEND_URL=http://127.0.0.1:4000
# Empty means browser calls use same-origin paths and Nginx routes /api/*.
NEXT_PUBLIC_BACKEND_URL=

# Keep empty until you create a Google OAuth Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match backend AUTH_BRIDGE_SECRET. Server-side only.
AUTH_BRIDGE_SECRET=REPLACE_WITH_THE_SAME_BACKEND_BRIDGE_SECRET
