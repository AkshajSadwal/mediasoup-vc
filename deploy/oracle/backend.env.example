# Oracle VM host deployment (backend)
PORT=4000
HOST=127.0.0.1
FRONTEND_URL=https://YOUR_DOMAIN

AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_BRIDGE_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS

# MediaSoup must listen on the VM interface and advertise its public IP.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=YOUR_ORACLE_VM_RESERVED_PUBLIC_IP
MEDIASOUP_RTC_MIN_PORT=2000
MEDIASOUP_RTC_MAX_PORT=2100
