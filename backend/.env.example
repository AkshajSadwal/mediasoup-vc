PORT=4000
FRONTEND_URL=http://localhost:3000
AUTH_SECRET=replace-this-with-a-unique-random-secret-at-least-32-characters
AUTH_BRIDGE_SECRET=replace-this-with-another-long-random-secret
MEDIASOUP_LISTEN_IP=127.0.0.1
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=2000
MEDIASOUP_RTC_MAX_PORT=2100

# Optional server-wide captions (Vosk + PyAV). Without a model, opted-in
# participants use browser speech recognition when supported.
# CAPTIONS_MODEL_PATH=/path/to/vosk-model-small-en-us-0.15
# CAPTIONS_PYTHON=/path/to/python/with-vosk-and-av
# CAPTIONS_MAX_SPEAKERS=10
